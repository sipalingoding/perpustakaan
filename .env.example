# Salin ke .env.local lalu isi. Jangan commit .env.local.
# Nilai Neon diambil dengan `neon env pull --file .env.neon` lalu disalin ke sini (jangan pull langsung ke .env.local).

# Postgres: pooled untuk aplikasi, unpooled (koneksi langsung) untuk migrasi.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
# Rahasia cookie sesi, minimal 32 karakter. Buat dengan: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (bucket uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Kata sandi akun pustakawan dari npm run admin:create. Minimal 8 karakter.
ADMIN_PASSWORD=
# Hanya untuk uji: kata sandi akun demo rani@contoh.id
DEMO_PASSWORD=
# Opsional: kunci Google Books API supaya pencarian buku di /admin juga memakai Google Books
GOOGLE_BOOKS_API_KEY=
