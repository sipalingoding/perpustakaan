# Salin ke .env.local lalu isi. Jangan commit .env.local.
# Nilai Neon diambil dengan `neon env pull --file .env.neon` lalu disalin ke sini (jangan pull langsung ke .env.local).

# Postgres: pooled untuk aplikasi, unpooled (koneksi langsung) untuk migrasi.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
# Rahasia cookie sesi, minimal 32 karakter. Buat dengan: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (bucket uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Kata sandi akun pustakawan dari npm run admin:create. Minimal 8 karakter.
ADMIN_PASSWORD=
# Hanya untuk uji: kata sandi akun demo rani@contoh.id
DEMO_PASSWORD=
# Opsional: menit tanpa aktivitas sebelum anggota otomatis keluar (bawaan 30). Isi 1 untuk menguji.
IDLE_TIMEOUT_MINUTES=
# Disarankan: kunci Google Books API (gratis, dengan kuota harian) dari Google Cloud Console > APIs & Services >
# Credentials. Pencarian buku sudah memakai data ISBN Perpusnas dan Open Library; Google Books menambah sampul dan
# sinopsis, terutama untuk buku terbitan Indonesia. Tanpa kunci, Google Books dilewati (kuota tanpa kunci sudah 0).
GOOGLE_BOOKS_API_KEY=
