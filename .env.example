# Salin ke .env.local lalu isi. Jangan commit .env.local.
# Nilai Neon diambil dengan `neon env pull --file .env.neon` lalu disalin ke sini (jangan pull langsung ke .env.local).

# Postgres: pooled untuk aplikasi, unpooled (koneksi langsung) untuk migrasi.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
# Rahasia cookie sesi, minimal 32 karakter. Buat dengan: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Opsional: JWKS untuk memeriksa JWT di header Authorization (bawaan <NEON_AUTH_BASE_URL>/.well-known/jwks.json).
NEON_AUTH_JWKS_URL=

# Neon Object Storage (bucket uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Kata sandi akun pustakawan dari npm run admin:create. Minimal 8 karakter.
ADMIN_PASSWORD=
# Hanya untuk uji: kata sandi akun demo rani@contoh.id
DEMO_PASSWORD=
# Opsional: menit tanpa aktivitas sebelum anggota otomatis keluar (bawaan 30). Isi 1 untuk menguji.
IDLE_TIMEOUT_MINUTES=
# Disarankan: kunci Google Books API (gratis, dengan kuota harian) dari Google Cloud Console > APIs & Services >
# Credentials. Pencarian buku sudah memakai data ISBN Perpusnas dan Open Library; Google Books menambah sampul dan
# sinopsis, terutama untuk buku terbitan Indonesia. Tanpa kunci, Google Books dilewati (kuota tanpa kunci sudah 0).
GOOGLE_BOOKS_API_KEY=

# Pengingat jatuh tempo ("Ingatkan aku" di Jadwal saya): dikirim tiap pagi 08.00 WIB lewat Vercel Cron
# (vercel.json -> /api/cron/pengingat). Kanal yang kosong dilewati.
# Rahasia cron: Vercel mengirimkannya otomatis bila variabel ini diisi di Project Settings. openssl rand -base64 32
CRON_SECRET=
# Email lewat Resend (resend.com > API Keys). EMAIL_FROM harus dari domain yang sudah diverifikasi di Resend,
# mis. "Perpustakaan Lembar <pengingat@domainmu.id>".
RESEND_API_KEY=
EMAIL_FROM=
# WhatsApp lewat Fonnte (fonnte.com): sambungkan nomor WhatsApp perpustakaan, lalu salin token perangkatnya.
FONNTE_TOKEN=
# Alamat situs untuk tautan di pesan, mis. https://lembar.domainmu.id (di Vercel otomatis dari domain produksi).
SITE_URL=
